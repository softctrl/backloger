# Diretório de um projeto já inicializado. O serviço não inicializa nem apaga dados.
BACKLOGER_PROJECT=.
BACKLOGER_PORT=8765
# Configure seu UID/GID (id -u; id -g) para permitir gravações no volume.
LOCAL_UID=1000
LOCAL_GID=1000
# Ativa a proteção na aplicação E read_only no volume Compose.
BACKLOGER_READ_ONLY=false
